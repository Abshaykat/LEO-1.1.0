# L.E.O. local configuration
LEO_HOME=D:\LEO
LEO_WORKSPACE=D:\LEO\workspace
LEO_APPROVAL_ROOT=D:\LEO\workspace\approvals
LEO_WORKFLOW_ROOT=D:\LEO\workspace\workflows
LEO_MEMORY_ROOT=D:\LEO\workspace\memory
LEO_AUDIT_ROOT=D:\LEO\workspace\audit
LEO_AGENT_ROOT=D:\LEO\workspace\agents
LEO_BACKUP_ROOT=E:\LEO-Backups
LEO_COMMAND_WORKING_DIRECTORY=D:\LEO

# Owner authentication
LEO_OWNER_ID=owner
LEO_UI_TOKEN=replace-with-a-long-random-local-token

# AES-256-GCM backup key. Keep this outside the project and never commit it.
LEO_BACKUP_KEY=replace-with-a-long-random-secret
\n# Optional secure mobile-to-PC cloud relay\nLEO_REMOTE_ENABLED=false\nLEO_REMOTE_WS_URL=wss://YOUR-WORKER-DOMAIN/ws\nLEO_REMOTE_DEVICE_ID=your-private-device-id\nLEO_REMOTE_TOKEN=replace-with-a-strong-remote-secret\n